#!/usr/bin/env bash
# Prints the Homebrew formula for a release, for the auxesis/homebrew-tap
# repository. The release workflow writes it to Formula/tally-light.rb.
#
#   scripts/homebrew-formula <tag> <sha256> [url]
#
# url defaults to the release asset for tag; pass one to test a local build.
#
# Prereleases (tags with a hyphen) are refused: the tap tracks stable
# releases only, so `brew upgrade` never moves anyone onto one.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: $0 <tag> <sha256> [url]" >&2
  exit 1
fi
tag=$1
sha256=$2
if [[ "$tag" == *-* ]]; then
  echo "$tag is a prerelease; the tap tracks stable releases only" >&2
  exit 1
fi

# Homebrew reads the version from a GitHub release URL, and `brew audit`
# rejects a version line that repeats it. A local test URL has to say it.
version_line=
if [ $# -ge 3 ]; then
  url=$3
  version_line="  version \"${tag#v}\""$'\n'
else
  url=https://github.com/auxesis/tally-light/releases/download/$tag/tally-light-darwin-arm64.tar.gz
fi

cat <<FORMULA
# Generated by scripts/homebrew-formula in auxesis/tally-light. Don't edit by
# hand: the next release overwrites it.
class TallyLight < Formula
  desc "Turns a Philips Hue light red while your webcam is in use"
  homepage "https://github.com/auxesis/tally-light"
  url "$url"
${version_line}  sha256 "$sha256"
  license "MIT"

  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "tally-light"
  end

  def caveats
    <<~EOS
      Write ~/.config/tally-light/config.toml (see #{homepage}#configuration),
      then install and start the service:
        sudo #{opt_bin}/tally-light install

      Upgrades restart the service on their own. Before uninstalling, run:
        sudo #{opt_bin}/tally-light uninstall
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/tally-light version")
  end
end
FORMULA
